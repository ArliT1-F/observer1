{
	"schemaVersion": 1,
	"id": "observer",
	"version": "${version}",
	"name": "Observer",
	"description": "This is an example description! Tell everyone what your mod is about!",
	"authors": [
		"Me!"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/observer/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.icy404.observer.ObserverMod"
		],
		"client": [
			"com.icy404.observer.ObserverClient"
		]
	},
	"mixins": [
		"observer.mixins.json",
		{
			"config": "observer.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=${loader_version}",
		"minecraft": "${minecraft_version}",
		"java": ">=17",
		"fabric-api": "*"
	}
}